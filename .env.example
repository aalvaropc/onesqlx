# =============================================================================
# Internal database (dev/test)
# These are read at compile time. Run `mix recompile` after changes.
# =============================================================================
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_PORT=5464
DB_DATABASE=onesqlx_dev  # Only applies to dev; test DB is always onesqlx_test

# =============================================================================
# External database (used by seeds — priv/repo/seeds.exs)
# =============================================================================
EXTERNAL_DB_HOST=localhost
EXTERNAL_DB_PORT=5433

# =============================================================================
# Phoenix / Endpoint
# =============================================================================
# SECRET_KEY_BASE=  # Generate with: mix phx.gen.secret

# =============================================================================
# Production-only (see config/runtime.exs)
# =============================================================================
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# PHX_HOST=example.com
# PHX_SERVER=true
# PORT=4000
# POOL_SIZE=10
# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=
