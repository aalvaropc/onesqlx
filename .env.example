# =============================================================================
# Internal database (dev/test)
# These are read at compile time. Run `mix recompile` after changes.
# =============================================================================
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_PORT=5464
DB_DATABASE=onesqlx_dev  # Only applies to dev; test DB is always onesqlx_test

# =============================================================================
# External database (used by seeds — priv/repo/seeds.exs)
# =============================================================================
EXTERNAL_DB_HOST=localhost
EXTERNAL_DB_PORT=5465

# =============================================================================
# Phoenix / Endpoint
# =============================================================================
# SECRET_KEY_BASE=  # Generate with: mix phx.gen.secret

# =============================================================================
# OAuth login (optional — enables Google / GitHub sign-in when set)
# See config/runtime.exs; applies to all environments.
# =============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# Production-only (see config/runtime.exs)
# =============================================================================
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# DATABASE_SSL=true      # TLS to the internal DB (system CA store)
# METRICS_TOKEN=         # enables /metrics with Authorization: Bearer <token>; unset = 404
# PHX_HOST=example.com
# PHX_SERVER=true
# PORT=4000
# POOL_SIZE=10
# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=
