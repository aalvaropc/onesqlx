<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <meta name="theme-color" content="#143e30" />
    <meta
      name="description"
      content="Connect PostgreSQL, write SQL, and turn your queries into shared dashboards. OneSQLx is an open-source analytics workspace."
    />
    <.live_title default="OneSQLx" suffix=" · OneSQLx">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {@inner_content}
  </body>
</html>
