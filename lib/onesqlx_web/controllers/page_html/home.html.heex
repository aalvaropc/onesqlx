<Layouts.app flash={@flash} current_scope={@current_scope} mode="marketing">
  <section class="marketing-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <h1 id="home-title">Good questions.<br /><span>Great discoveries.</span></h1>
      <p>
        Your PostgreSQL data has a story. Find it with SQL, bring it to life in dashboards, and share the next insight with your team.
      </p>
      <div class="hero-actions">
        <.link
          navigate={if(@current_scope, do: ~p"/sql-editor", else: ~p"/users/register")}
          class="ui-button"
        >
          {if(@current_scope, do: "Open your workspace", else: "Start exploring")}
          <.icon name="hero-arrow-up-right" class="size-4" />
        </.link>
        <a href="#workflow" class="hero-secondary">
          See how it works <.icon name="hero-arrow-down" class="size-3.5" />
        </a>
      </div>
      <div class="hero-proof">
        <span><.icon name="hero-code-bracket" class="size-3.5" /> SQL first</span>
        <span><.icon name="hero-circle-stack" class="size-3.5" /> PostgreSQL native</span>
        <span><.icon name="hero-lock-open" class="size-3.5" /> Open source</span>
      </div>
    </div>
    <div
      class="product-demo"
      aria-label="Illustrative example of a SQL query and its result chart"
    >
      <div class="demo-titlebar">
        <strong><.icon name="hero-code-bracket" class="size-3.5" /> Monthly revenue.sql</strong>
        <span>Example workspace</span>
      </div>
      <pre class="demo-code"><span class="line-number">1</span><span class="keyword">SELECT</span> date_trunc(<span class="literal">'month'</span>, ordered_at),
<span class="line-number">2</span>       <span class="keyword">SUM</span>(total) <span class="keyword">AS</span> revenue
<span class="line-number">3</span><span class="keyword">FROM</span> orders
<span class="line-number">4</span><span class="keyword">GROUP BY</span> 1
<span class="line-number">5</span><span class="keyword">ORDER BY</span> 1;</pre>
      <div class="demo-results">
        <div class="demo-results-heading">
          <strong>Revenue by month</strong><span>Illustrative data · USD</span>
        </div>
        <div
          class="demo-chart"
          role="img"
          aria-label="Example revenue chart: January 24,000, February 32,000, March 29,000, April 41,000, May 38,000, June 52,000 dollars"
        >
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-[46%]"></div>
          </div>
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-[61%]"></div>
          </div>
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-[55%]"></div>
          </div>
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-[79%]"></div>
          </div>
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-[73%]"></div>
          </div>
          <div class="demo-chart-column">
            <div class="demo-chart-bar h-full"></div>
          </div>
        </div>
        <div class="demo-chart-labels" aria-hidden="true">
          <span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span>
        </div>
      </div>
      <div class="demo-footer"><span>PostgreSQL → SQL → Insight</span><span>OneSQLx</span></div>
    </div>
  </section>

  <section id="workflow" class="product-path" aria-label="Your analytical workflow">
    <div class="product-path-item">
      <.icon name="hero-circle-stack" class="size-5" />
      <div>
        <h2>Connect your world.</h2>
        <p>Add a PostgreSQL source and explore its schemas, tables, and columns.</p>
      </div>
    </div>
    <div class="product-path-item">
      <.icon name="hero-code-bracket" class="size-5" />
      <div>
        <h2>Follow your curiosity.</h2>
        <p>Write SQL with autocomplete, save queries, and pick up where you left off.</p>
      </div>
    </div>
    <div class="product-path-item">
      <.icon name="hero-chart-bar-square" class="size-5" />
      <div>
        <h2>Make it a shared insight.</h2>
        <p>Build dashboards, schedule reports, and keep your team in the picture.</p>
      </div>
    </div>
  </section>

  <section class="marketing-details" aria-labelledby="details-title">
    <div>
      <h2 id="details-title">From a quick query to a clearer picture.</h2>
      <p>
        A SQL-first analytics platform that keeps the tools you need in one workspace, so you can spend more time understanding your data.
      </p>
      <a
        href="https://github.com/aalvaropc/onesqlx"
        class="ui-link inline-flex items-center gap-2 mt-6 text-xs"
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore the project <.icon name="hero-arrow-up-right" class="size-3.5" />
      </a>
    </div>
    <div>
      <div class="feature-line">
        <.icon name="hero-window" class="size-5" />
        <div>
          <h3>A workspace built around SQL</h3>
          <p>
            Multiple editor tabs, schema-aware autocomplete, query history, reusable snippets, and CSV, JSON, or Excel exports.
          </p>
        </div>
      </div>
      <div class="feature-line">
        <.icon name="hero-users" class="size-5" />
        <div>
          <h3>Find it together. Share it clearly.</h3>
          <p>
            Shared workspaces with role-based access, saved queries, interactive dashboards, and read-only sharing links.
          </p>
        </div>
      </div>
      <div class="feature-line">
        <.icon name="hero-clock" class="size-5" />
        <div>
          <h3>Let your next report come to you</h3>
          <p>
            Scheduled queries, conditional alerts, email and webhook notifications, and a scoped REST API for your own workflows.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
